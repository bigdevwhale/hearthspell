    <string name="setup_back">Back</string>
    <string name="setup_take_keys">Take the keys</string>
    <string name="setup_open_tower">Open the tower</string>
    <string name="setup_farewell_title">A NOTE ON THE DOOR</string>
    <string name="setup_farewell_text">I\'m off travelling, and I don\'t know for how long. The tower is yours now. Keep the fire lit, the floors swept and the cauldron clean. And whatever you do, don\'t let the imps take the kitchen.</string>
    <string name="setup_farewell_sign">Your old master</string>
    <string name="setup_farewell_hint">The tower is your home: every floor is a room, every chore is a spell. Cast them, and the tower stays bright.</string>
    <string name="setup_name_title">Your name</string>
    <string name="setup_name_sub">So the master knows whom to write to.</string>
    <string name="setup_name_hint">Apprentice</string>
    <string name="setup_gender">How to address you</string>
    <string name="setup_gender_male">Apprentice (he)</string>
    <string name="setup_gender_female">Apprentice (she)</string>
    <string name="setup_rooms_title">Your rooms</string>
    <string name="setup_rooms_sub">Each room of your home becomes a floor of the tower. Pick the ones you have.</string>
    <string name="setup_spells_title">Your spells</string>
    <string name="setup_spells_sub">The chores you do in each room. A spell fades over its interval; cast it to make it shine again.</string>
    <string name="setup_spells_later">Intervals, names and helpers can be changed any time, and you can add your own spells.</string>
    <string name="setup_remind_title">A daily whisper</string>
    <string name="setup_remind_sub">Once a day the helpers tell you where the imps have moved in. Never more often.</string>
    <string name="setup_remind_toggle">Daily reminder</string>
    <string name="setup_remind_time">Time</string>
    <string name="setup_remind_note">Nothing is ever lost here: no streaks to break, no punishments. A dusty floor just waits for you.</string>
    <string name="setup_remind_imps">Imps are harmless. They only giggle until you shoo them away.</string>

